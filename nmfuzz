  nmfuzz <command> [options]

${BOLD}COMMANDS:${NC}

  ${GREEN}settarget${NC} <ip> <name>
      Set the target and create the workspace directory structure.
      Also saves the configuration for subsequent commands.

  ${GREEN}portscan${NC} [--target <ip> <name>] [--udp]
      Phase 1: Full SYN scan (--min-rate ${NMAP_MIN_RATE}, -n, -Pn)    → allPorts
      Phase 2: Version detection and scripts (-sCV)              → targeted
      Phase 3: UDP scan (optional, with --udp)                   → udp-targeted

  ${GREEN}webscan${NC} [--target <ip> <name>] [options]
      Directory brute-force with gobuster on detected HTTP ports.
      Options:
        --wordlist/-w <path>    Custom wordlist
        --ext/-x <exts>         Extensions (default: php,html,txt,js,bak)
        --threads/-t <n>        Concurrent threads (default: 50)

  ${GREEN}subfuzz${NC} [--target <ip> <name>] [options]
      Subdomain fuzzing with wfuzz.
      Options:
        --domain/-d <domain>    Base domain (default: <name>.htb)
        --wordlist/-w <path>    Custom wordlist
        --threads/-t <n>        Concurrent threads (default: 50)

  ${GREEN}enum${NC} [--target <ip> <name>] [options]
      Orchestrates the full enumeration pipeline.
      Options:
        --udp                   Include UDP scan
        --wordlist/-w <path>    Wordlist for gobuster
        --sub-wordlist <path>   Wordlist for wfuzz
        --domain/-d <domain>    Domain for subdomain fuzzing

  ${GREEN}status${NC}
      Show the current target and scan file status.

  ${GREEN}help${NC}
      Show this help message.

${BOLD}EXAMPLES:${NC}

  # Step-by-step workflow:
  nmfuzz settarget 10.10.11.23 HackMe
  nmfuzz portscan
  nmfuzz webscan --wordlist /usr/share/wordlists/dirbuster/common.txt
