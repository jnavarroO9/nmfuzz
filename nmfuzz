  │   └── udp-targeted   (UDP — nmap, if requested)
  ├── content/
  │   ├── gobuster_80.txt
  │   └── subdomains_<domain>.txt
  └── exploits/

${BOLD}DEFAULT WORDLISTS:${NC}
  Dir scan    : ${DEFAULT_DIR_WORDLIST}
  Subdomains  : ${DEFAULT_SUB_WORDLIST}

${BOLD}NOTES:${NC}
  • portscan and enum require ${RED}root${NC} (nmap SYN scan -sS)
  • Target configuration is saved to: ${CONFIG_FILE}

EOF
}

# ─── Dispatcher ───────────────────────────────────────────────────────────────
main() {
    [[ $# -eq 0 ]] && { cmd_help; exit 0; }

    local cmd="$1"; shift

    case "$cmd" in
        settarget)    cmd_settarget "$@" ;;
        portscan)     cmd_portscan  "$@" ;;
        webscan)      cmd_webscan   "$@" ;;
        subfuzz)      cmd_subfuzz   "$@" ;;
        enum)         cmd_enum      "$@" ;;
        status)       cmd_status    "$@" ;;
        help|--help|-h) cmd_help    "$@" ;;
        *)
            error "Unknown command: '${cmd}'"
            echo ""
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
